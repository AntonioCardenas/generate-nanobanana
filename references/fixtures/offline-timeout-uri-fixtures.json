{
  "schema_version": 2,
  "description": "Offline URI allowlist, magic-byte MIME detection, and end-to-end bounded SDK polling/download/cleanup regression fixtures",
  "uri_cases": [
    {
      "id": "valid_v1_files_uri",
      "uri": "https://generativelanguage.googleapis.com/v1/files/abc123def456",
      "valid": true,
      "expected_resource": "files/abc123def456"
    },
    {
      "id": "valid_v1beta_files_uri",
      "uri": "https://generativelanguage.googleapis.com/v1beta/files/vid-987654321",
      "valid": true,
      "expected_resource": "files/vid-987654321"
    },
    {
      "id": "reject_untrusted_external_host",
      "uri": "https://attacker.example.com/v1/files/abc123def456",
      "valid": false
    },
    {
      "id": "reject_http_downgrade",
      "uri": "http://generativelanguage.googleapis.com/v1/files/abc123def456",
      "valid": false
    },
    {
      "id": "reject_path_traversal_or_naive_split",
      "uri": "https://generativelanguage.googleapis.com/v1/projects/secret/files/../../abc123",
      "valid": false
    },
    {
      "id": "reject_query_string_credential_leak",
      "uri": "https://generativelanguage.googleapis.com/v1/files/abc123?redirect=https://evil.test",
      "valid": false
    }
  ],
  "mime_magic_cases": [
    {
      "id": "jpeg_bytes_with_wrong_png_extension_detected_as_jpeg",
      "filename": "misnamed_photo.png",
      "hex_prefix": "ffd8ffe000104a4649460001",
      "expected_mime": "image/jpeg"
    },
    {
      "id": "png_bytes_detected_as_png",
      "filename": "logo.png",
      "hex_prefix": "89504e470d0a1a0a0000000d",
      "expected_mime": "image/png"
    },
    {
      "id": "webp_bytes_detected_as_webp",
      "filename": "style_ref.webp",
      "hex_prefix": "524946462400000057454250",
      "expected_mime": "image/webp"
    }
  ],
  "bounded_retrieval_regression_cases": [
    {
      "id": "uri_video_within_budget_commits_atomically",
      "total_budget_s": 25.0,
      "poll_interval_s": 5.0,
      "create_latency_s": 2.0,
      "uri": "https://generativelanguage.googleapis.com/v1/files/omni-clip-001",
      "poll_steps": [
        { "state": "PROCESSING", "latency_s": 1.0 },
        { "state": "PROCESSING", "latency_s": 1.0 },
        { "state": "ACTIVE", "latency_s": 1.0 }
      ],
      "download_latency_s": 3.0,
      "download_hex": "00000018667479706d703432",
      "expected_outcome": "SUCCESS",
      "expected_download_timeout_ms_max": 10000
    },
    {
      "id": "slow_create_call_exceeds_total_budget",
      "total_budget_s": 4.0,
      "poll_interval_s": 2.0,
      "create_latency_s": 4.5,
      "uri": "https://generativelanguage.googleapis.com/v1/files/omni-clip-002",
      "poll_steps": [
        { "state": "ACTIVE", "latency_s": 0.5 }
      ],
      "download_latency_s": 0.5,
      "download_hex": "00000018667479706d703432",
      "expected_outcome": "TimeoutError",
      "expect_download_called": false
    },
    {
      "id": "slow_poll_sdk_call_exceeds_remaining_deadline",
      "total_budget_s": 10.0,
      "poll_interval_s": 5.0,
      "create_latency_s": 2.0,
      "uri": "https://generativelanguage.googleapis.com/v1/files/omni-clip-003",
      "poll_steps": [
        { "state": "PROCESSING", "latency_s": 1.0 },
        { "state": "ACTIVE", "latency_s": 3.0 }
      ],
      "download_latency_s": 0.5,
      "download_hex": "00000018667479706d703432",
      "expected_outcome": "TimeoutError",
      "expect_download_called": false
    },
    {
      "id": "slow_final_download_exceeds_remaining_deadline_and_cleans_staging",
      "total_budget_s": 12.0,
      "poll_interval_s": 5.0,
      "create_latency_s": 2.0,
      "uri": "https://generativelanguage.googleapis.com/v1/files/omni-clip-004",
      "poll_steps": [
        { "state": "PROCESSING", "latency_s": 1.5 },
        { "state": "ACTIVE", "latency_s": 1.5 }
      ],
      "download_latency_s": 2.5,
      "download_hex": "00000018667479706d703432",
      "expected_outcome": "TimeoutError",
      "expect_download_called": true,
      "expected_download_timeout_ms_max": 2000
    },
    {
      "id": "failed_remote_file_state_aborts_immediately_without_download",
      "total_budget_s": 60.0,
      "poll_interval_s": 5.0,
      "create_latency_s": 1.0,
      "uri": "https://generativelanguage.googleapis.com/v1/files/omni-clip-005",
      "poll_steps": [
        { "state": "PROCESSING", "latency_s": 0.5 },
        { "state": "FAILED", "latency_s": 0.5 }
      ],
      "download_latency_s": 0.5,
      "download_hex": "00000018667479706d703432",
      "expected_outcome": "RuntimeError",
      "expect_download_called": false
    },
    {
      "id": "empty_download_payload_rejected_and_cleaned",
      "total_budget_s": 30.0,
      "poll_interval_s": 5.0,
      "create_latency_s": 1.0,
      "uri": "https://generativelanguage.googleapis.com/v1/files/omni-clip-006",
      "poll_steps": [
        { "state": "ACTIVE", "latency_s": 0.5 }
      ],
      "download_latency_s": 0.5,
      "download_hex": "",
      "expected_outcome": "RuntimeError",
      "expect_download_called": true
    }
  ]
}
